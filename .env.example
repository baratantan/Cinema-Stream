# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# TMDB_API_KEY: Required for TMDB movie catalog API.
# Leave blank to run in offline catalog mode with automated streaming.
TMDB_API_KEY=YOUR_TMDB_API_KEY

# ADSTERRA_BANNER_KEY: Optional Adsterra 32-character placement key (e.g. b3b2c1f0d3a5e6f7...)
# If left blank or missing, ad banners will not be displayed.
ADSTERRA_BANNER_KEY=24c50089c680c12fbf6796d4b7fef484

# ADSTERRA_BANNER_DOMAIN: The script domain used by your Adsterra ad unit (e.g. embargotechniquebattle.com)
ADSTERRA_BANNER_DOMAIN=embargotechniquebattle.com

# ADSTERRA_BANNER_WIDTH: The width of your banner ad in pixels
ADSTERRA_BANNER_WIDTH=300

# ADSTERRA_BANNER_HEIGHT: The height of your banner ad in pixels
ADSTERRA_BANNER_HEIGHT=250

# ADSTERRA_SMART_LINK: Optional Adsterra Smart Link URL (e.g. https://www.profitablecpmrate.com/abcdef)
# If left blank, clicking play or server buttons won't open external ad pages.
ADSTERRA_SMART_LINK=YOUR_ADSTERRA_SMART_LINK_HERE

